# local dev — copy to .env
WAM_ADDR=:8080
WAM_ENV=development
WAM_LOG_LEVEL=info
WAM_PUBLIC_BASE_URL=http://localhost:8080
# WAM_DB_PATH=./data/wam.db
# WAM_DATA_DIR=./data
# SaaS platform: Postgres is authoritative when set (RLS tenant isolation).
# WAM_DATABASE_URL is the OWNER DSN (DDL migrations). Compose local default:
# postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable
# WAM_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# Least-privilege runtime DSN (role pre-created out-of-band; migrations refuse
# to mint it — see migrations/003_app_role.sql and docker/postgres-init).
# WAM_APP_DATABASE_URL=postgres://wam_app:wam_app@localhost:5432/postgres?sslmode=disable
# Session-store DSN (owner; whatsmeow creates session tables at runtime).
# Defaults to WAM_DATABASE_URL when unset.
# WAM_WA_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# Reserved for sender-scale queue (parsed, not yet dialed):
# WAM_REDIS_URL=redis://localhost:6379
# WAM_ADMIN_PASSWORD=change-me
# WAM_SESSION_SECRET=change-me-32-bytes-min
