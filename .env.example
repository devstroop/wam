# local dev — copy to .env
WAM_ADDR=:8080
WAM_ENV=development
WAM_LOG_LEVEL=info
WAM_PUBLIC_BASE_URL=http://localhost:8080
# WAM_DB_PATH=./data/wam.db
# WAM_DATA_DIR=./data
# SaaS platform: Postgres is authoritative when set (RLS tenant isolation).
# Copy to .env and set real values. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
# No defaults committed: required by compose. Plain text, avoid single quotes
# (interpolated into the wam_app CREATE ROLE statement at first DB init).
POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me-app
# Owner DSN (DDL: migrate job + wam migrate-schema). Compose service host is
# `postgres`; localhost when running the server outside compose.
WAM_DATABASE_URL=postgres://postgres:change-me@postgres:5432/postgres?sslmode=disable
# Runtime DSN (least-privilege wam_app; RLS enforced).
WAM_APP_DATABASE_URL=postgres://wam_app:change-me-app@postgres:5432/postgres?sslmode=disable
# Session-store DSN (owner; whatsmeow creates session tables at runtime).
# Defaults to WAM_DATABASE_URL when unset.
WAM_WA_DATABASE_URL=postgres://postgres:change-me@postgres:5432/postgres?sslmode=disable
# Reserved for sender-scale queue (parsed, not yet dialed):
# WAM_REDIS_URL=redis://localhost:6379
# WAM_ADMIN_PASSWORD=change-me
# Admin email for the seeded first admin (fresh Postgres boot with zero users).
# WAM_ADMIN_EMAIL=admin@example.com
# WAM_SESSION_SECRET=change-me-32-bytes-min
